# SCForge 前端环境变量（复制为 .env.local 后按需修改；.env.local 不提交）

# 后端 API 的地址。
#   留空 = 用相对路径：开发时走 Vite 代理（见下面的 VITE_API_PROXY_TARGET），
#          生产时前后端同源（推荐，Cookie 会话不会被跨站策略拦）。
#   https://api.example.com = 前后端分离部署时直接指向 API 源。
VITE_API_BASE=

# 开发服务器把 /scforge 与 /identity 代理到哪台后端。
VITE_API_PROXY_TARGET=http://localhost:5171
